{
  "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
  "id": "duxHerdrFleet",
  "name": "Dux Herdr Fleet",
  "description": "Multi-machine and workspace agent monitor for herdr and optional Herdr Desktop App (hc/herdr-app) with live status filters, search, context tokens, machine filter, clickable notifications, and cross-machine pane focus (compositor window focus is Niri-only). Fork of Mor-dev/herdr-agent-monitor.",
  "version": "1.2.0",
  "author": "arqueon",
  "repo": "https://github.com/arqueon/dux-herdr-fleet",
  "icon": "smart_toy",
  "type": "widget",
  "category": "monitoring",
  "capabilities": [
    "dankbar-widget",
    "monitoring",
    "ipc"
  ],
  "component": "./HerdrFleetWidget.qml",
  "settings": "./HerdrFleetSettings.qml",
  "permissions": [
    "process",
    "settings_read",
    "settings_write"
  ],
  "dependencies": [
    "herdr",
    "python3",
    "jq"
  ],
  "compositors": [
    "any"
  ],
  "distro": [
    "any"
  ],
  "requires_dms": ">=2.0.0",
  "screenshot": "https://raw.githubusercontent.com/arqueon/dux-herdr-fleet/main/assets/screenshot.png"
}
