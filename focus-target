        if [[ -z "$machine" || "$machine" == "local" ]]; then
            focus_herdr_pane "$machine" "$target_id"
        fi
        if [[ -n "$workspace_id" ]]; then
            "${herdr_cmd[@]}" workspace focus "$workspace_id" >/dev/null 2>&1 || true
        fi
        if [[ -n "$tab_id" ]]; then
            "${herdr_cmd[@]}" tab focus "$tab_id" >/dev/null 2>&1 || true
        fi
        focus_herdr_pane "$machine" "$target_id"
    fi
}

HERDR_SWITCHED_ENDPOINT=0
HERDR_SWITCH_CONFIRMED=0
HERDR_SWITCH_FAILED=0
focus_niri_herdr_window "$machine" "$workspace_label" "1"
if [[ "$HERDR_SWITCHED_ENDPOINT" == "1" ]]; then
    # Give the client a moment to attach to the newly selected endpoint.
    sleep 0.15
fi
focus_herdr_target_on_server
flog "done kind=$kind machine=$machine target=$target_id switched=$HERDR_SWITCHED_ENDPOINT confirmed=$HERDR_SWITCH_CONFIRMED failed=$HERDR_SWITCH_FAILED"
if [[ "$HERDR_SWITCH_FAILED" == "1" ]] && command -v dms >/dev/null 2>&1; then
    # Server-side focus was applied; the client just needs the user to pick the machine.
    dms notify --app-name "Dux Herdr Fleet" --icon utilities-terminal --expire-time 6000 -- \
        "herdr: switch to ${machine}" \
        "The pane is focused on ${machine}. Select that machine in herdr (workspace picker or sidebar) to see it." \
        >/dev/null 2>&1 || true
fi

exit 0
