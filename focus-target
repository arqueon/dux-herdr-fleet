def load_goto_chords():
    prefix, chords = "ctrl+space", ["prefix+g", "alt+g"]
    try:
        with open(os.path.expanduser("~/.config/herdr/config.toml"), "r", encoding="utf-8") as fh:
            content = fh.read()
        m = re.search(r'(?m)^\s*prefix\s*=\s*"([^"]+)"', content)
        if m:
            prefix = m.group(1).strip().lower()
        m = re.search(r"(?m)^\s*goto\s*=\s*\[([^\]]+)\]", content)
        if m:
            parsed = [x.strip().strip('"').strip("'").lower() for x in m.group(1).split(",") if x.strip()]
            chords = parsed or chords
    except Exception:
        pass
    seqs = [[c] for c in chords if not c.startswith("prefix+")]
    seqs += [[prefix, c.split("+", 1)[1]] for c in chords if c.startswith("prefix+")]
    return seqs


# 1. Open the Go to overlay with ONE chord only. Never try a second chord: if the first
#    one opened the overlay but the check missed it, a second chord (e.g. prefix, then
#    "g") would close it and type into the agent's pane.
seq = load_goto_chords()[0]
