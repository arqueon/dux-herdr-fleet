#!/usr/bin/env bash
# Focuses an agent pane, workspace, or notification target in herdr (local or remote machine)
# or Herdr App (hc), and focuses the corresponding terminal or Herdr App window in Niri.
#
# Usage:
#   focus-target agent <backend> <machine_id> <pane_id> [workspace_id] [tab_id] [workspace_label]
#   focus-target workspace <backend> <machine_id> <workspace_id> [tab_id] [workspace_label]
#   focus-target window [backend] [machine_id]
#   focus-target notification <summary> <body>
#   focus-target reemit-notification <summary> <body>

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HERDR_SWITCHED_ENDPOINT=0
HERDR_SWITCH_CONFIRMED=0
HERDR_SWITCH_FAILED=0
FOCUS_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/dux-herdr-fleet/focus.log"
mkdir -p "$(dirname "$FOCUS_LOG")" 2>/dev/null || FOCUS_LOG=/dev/null
# Keep the log small: last ~400 lines.
if [[ -f "$FOCUS_LOG" ]] && (( $(wc -l < "$FOCUS_LOG") > 600 )); then
    tail -n 400 "$FOCUS_LOG" > "$FOCUS_LOG.tmp" 2>/dev/null && mv "$FOCUS_LOG.tmp" "$FOCUS_LOG"
fi
flog() { printf '%s %s\n' "$(date '+%F %T.%3N')" "$*" >> "$FOCUS_LOG" 2>/dev/null || true; }
flog "focus-target $*"
kind="${1:-window}"
backend="${2:-herdr}"
machine="${3:-local}"
target_id="${4:-}"
workspace_id="${5:-}"
tab_id="${6:-}"
workspace_label="${7:-}"
first_pane_id=""
if [[ "$kind" == "workspace" ]]; then
    tab_id="${5:-}"
    workspace_label="${6:-}"
    first_pane_id="${7:-}"
fi

ensure_runtime_env() {
    export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        local wsock
        for wsock in "$XDG_RUNTIME_DIR"/wayland-*; do
            if [[ -S "$wsock" ]]; then
                export WAYLAND_DISPLAY
                WAYLAND_DISPLAY="$(basename "$wsock")"
                break
            fi
        done
    fi
    if [[ -z "${NIRI_SOCKET:-}" || ! -S "${NIRI_SOCKET:-}" ]]; then
        local nsock
        for nsock in $(ls -t "$XDG_RUNTIME_DIR"/niri*.sock 2>/dev/null || true); do
            if [[ -S "$nsock" ]] && NIRI_SOCKET="$nsock" niri msg -j version >/dev/null 2>&1; then
                export NIRI_SOCKET="$nsock"
                break
            fi
        done
    fi
}

# Focuses a Niri window and waits until it really holds keyboard focus (no layer-shell
# surface such as the DMS popout still grabbing the keyboard). Returns 1 if focus could
# not be verified, so callers never inject synthetic keys into some other window.
wait_niri_window_focus() {
    local win_id="${1:-}"
    [[ -n "$win_id" ]] || return 1
    local i focused_id blocking_layers
    for i in {1..30}; do
        blocking_layers="$(
            niri msg -j layers 2>/dev/null | jq -r '
                [ .[] | select(
                    ((.keyboard_interactivity // "None" | tostring | ascii_downcase) == "exclusive")
                    or (
                        ((.namespace // "") | startswith("dms:"))
                        and ((.keyboard_interactivity // "None" | tostring | ascii_downcase) != "none")
                    )
                ) ] | length
            ' 2>/dev/null || echo "0"
        )"
        niri msg action focus-window --id "$win_id" >/dev/null 2>&1 || true
        focused_id="$(niri msg -j focused-window 2>/dev/null | jq -r '.id // empty' 2>/dev/null || true)"
        if [[ "$focused_id" == "$win_id" && "${blocking_layers:-0}" == "0" ]]; then
            sleep 0.08
            return 0
        fi
        sleep 0.025
    done
    return 1
}

focus_herdr_pane_rpc() {
    local target_machine="${1:-local}"
    local pane_id="${2:-}"
    [[ -n "$pane_id" ]] || return 1
    if [[ -z "$target_machine" || "$target_machine" == "local" ]]; then
        python3 - "$pane_id" <<'PY' >/dev/null 2>&1
import json, os, socket, sys
pane_id = sys.argv[1]
sock_path = os.path.expanduser("~/.config/herdr/herdr.sock")
if not os.path.exists(sock_path):
    raise SystemExit(1)
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(1.0)
s.connect(sock_path)
s.sendall((json.dumps({"id": "1", "method": "pane.focus", "params": {"pane_id": pane_id}}) + "\n").encode())
resp = s.recv(4096).decode("utf-8", "replace")
s.close()
if '"error"' in resp:
    raise SystemExit(1)
PY
        return $?
    fi
    return 1
}

