# Mode (DUX_HERDR_ENDPOINT_SWITCH): kitty (default) = kitty remote control only;
# auto = kitty if available, else the Wayland virtual keyboard (opt-in);
# keyboard = virtual keyboard only; off = never send keys.
switch_herdr_tui_endpoint() {
    local mode="${DUX_HERDR_ENDPOINT_SWITCH:-kitty}" rc
    flog "switch to '$1' mode=$mode"
    case "$mode" in
        off) flog "switch disabled"; return 1 ;;
        keyboard)
            switch_via_virtual_keyboard "$@"; rc=$?
            flog "virtual keyboard exit $rc"; return "$rc" ;;
    esac
    switch_via_kitty "$@"
    rc=$?
    flog "kitty exit $rc"
    if [[ "$rc" == "3" ]]; then
        [[ "$mode" == "kitty" ]] && return 1
        switch_via_virtual_keyboard "$@"
        rc=$?
        flog "virtual keyboard exit $rc"
    fi
    return "$rc"
}

endpoint_matches_win_host() {
    local ep="${1,,}"
    local wh="${2,,}"
    local lh="${3,,}"
    [[ -n "$wh" ]] || return 1
    if [[ "$ep" == "local" ]]; then
        [[ "$wh" == "$lh" || "$wh" == "local" ]]
        return $?
    fi
    [[ "$wh" == "$lh" || "$wh" == "local" ]] && return 1
    [[ "$wh" == "$ep" || "$wh" == *"$ep"* || "$ep" == *"$wh"* ]] && return 0
    if [[ "${#ep}" -ge 3 ]]; then
        local ep_prefix="${ep:0:3}"
        [[ "$wh" == *"-${ep_prefix}"* || "$wh" == "${ep_prefix}-"* ]] && return 0
    fi
    return 1
}

focus_niri_herdr_window() {
    local target_machine="${1:-local}"
    local target_ws_label="${2:-}"
    local allow_switch="${3:-0}"
    command -v niri >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local windows_json
    windows_json="$(niri msg -j windows 2>/dev/null)" || return 0
    [[ -n "$windows_json" ]] || return 0

    local local_host
    local_host="$(hostname 2>/dev/null || echo "local")"
    local desired_endpoint="${target_machine:-local}"
    local target_host="$desired_endpoint"
    if [[ "$desired_endpoint" == "local" ]]; then
        target_host="$local_host"
    fi

    # Collect ancestor PIDs of active herdr TUI client processes (excluding server and remote bridges)
    local herdr_pids client_pids="" p cmd cur ancestor_pids=","
    herdr_pids="$(pgrep -x herdr 2>/dev/null || true)"
    for p in $herdr_pids; do
        cmd="$(ps -o args= -p "$p" 2>/dev/null || true)"
        if [[ "$cmd" != *"herdr server"* && "$cmd" != *"remote-client-bridge"* ]]; then
            client_pids="$client_pids $p"
        fi
    done
    [[ -z "${client_pids// /}" ]] && client_pids="$herdr_pids"

    for p in $client_pids; do
        cur="$p"
        while [[ -n "$cur" && "$cur" != "1" && "$cur" != "0" ]]; do
            if [[ "$ancestor_pids" != *",$cur,"* ]]; then
                ancestor_pids="${ancestor_pids}${cur},"
            fi
            cur="$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ')"
        done
    done

    local win_info win_id="" win_title=""
    win_info="$(
        jq -r --arg anc "$ancestor_pids" --arg thost "$target_host" '
            def is_anc: (.pid != null) and ((.pid | tostring) as $p | ($anc | contains("," + $p + ",")));
            def title_lc: (.title // "" | ascii_downcase);
            def app_lc: (.app_id // "" | ascii_downcase);
            def matches_host: title_lc | startswith(($thost | ascii_downcase) + ": ");
            def looks_like_herdr: (title_lc | contains("herdr")) or (app_lc | contains("herdr")) or (title_lc | test("^[a-z0-9._-]+: "));

            (
                [ .[] | select(is_anc and matches_host) ]
                + [ .[] | select(is_anc and looks_like_herdr) ]
                + [ .[] | select(is_anc) ]
                + [ .[] | select(matches_host) ]
                + [ .[] | select(looks_like_herdr) ]
            )
            | first
            | if . then "\(.id)\t\(.title // "")" else empty end
        ' <<<"$windows_json" 2>/dev/null
    )"

    if [[ -n "$win_info" ]]; then
        IFS=$'\t' read -r win_id win_title <<<"$win_info"
    fi

    if [[ -n "$win_id" ]]; then
        local focused_ok=0
        wait_niri_window_focus "$win_id" && focused_ok=1
        if [[ "$allow_switch" == "1" ]]; then
            local win_host="" needs_switch=0
            if [[ "$win_title" == *": "* ]]; then
                win_host="${win_title%%: *}"
            fi
            if [[ -n "$win_host" ]]; then
                endpoint_matches_win_host "$desired_endpoint" "$win_host" "$local_host" || needs_switch=1
            else
                local active_endpoint
                active_endpoint="$(current_herdr_tui_endpoint)"
                if [[ -n "$active_endpoint" && "${active_endpoint,,}" != "${desired_endpoint,,}" ]]; then
                    needs_switch=1
                fi
            fi

            flog "window $win_id '$win_title' focused_ok=$focused_ok win_host='$win_host' selected='$(current_herdr_tui_endpoint)' target='$desired_endpoint' needs_switch=$needs_switch"
            if [[ "$needs_switch" == "1" ]]; then
                # The kitty path targets the window directly and the virtual-keyboard path
                # re-verifies keyboard focus itself, so both are safe to call from here.
                local switch_rc
                switch_herdr_tui_endpoint "$desired_endpoint" "$client_pids" "$win_id"
                switch_rc=$?
                case "$switch_rc" in
                    0) HERDR_SWITCHED_ENDPOINT=1; HERDR_SWITCH_CONFIRMED=1 ;;
                    2) HERDR_SWITCHED_ENDPOINT=1 ;;
                    *) HERDR_SWITCH_FAILED=1 ;;
                esac
            fi

            if [[ "$HERDR_SWITCHED_ENDPOINT" == "1" && "$HERDR_SWITCH_CONFIRMED" != "1" ]]; then
                local poll_i cur_title cur_host
                for poll_i in {1..15}; do
                    cur_title="$(
                        niri msg -j windows 2>/dev/null \
                            | jq -r --arg wid "$win_id" '.[] | select((.id | tostring) == $wid) | (.title // "")' 2>/dev/null \
                            | head -n1
                    )"
                    cur_host=""
                    if [[ "$cur_title" == *": "* ]]; then
                        cur_host="${cur_title%%: *}"
                    fi
                    if [[ -n "$cur_host" ]] && endpoint_matches_win_host "$desired_endpoint" "$cur_host" "$local_host"; then
                        break
                    fi
                    sleep 0.04
                done
            fi
        fi
    fi
}

focus_niri_hc_window() {
    command -v niri >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local windows_json win_id
    windows_json="$(niri msg -j windows 2>/dev/null)" || return 0
    [[ -n "$windows_json" ]] || return 0

    win_id="$(
        jq -r '
            .[]
            | select(
                ((.app_id // "" | ascii_downcase) == "herdr-app")
                or ((.title // "" | ascii_downcase) == "herdr")
                or ((.app_id // "" | ascii_downcase) | contains("herdr-app"))
            )
            | .id
        ' <<<"$windows_json" 2>/dev/null | head -n1
    )"
    if [[ -n "$win_id" ]]; then
        wait_niri_window_focus "$win_id"
    fi
}

